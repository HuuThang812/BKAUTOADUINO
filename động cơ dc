#define IN1 1
#define IN2 2
#define ENA 3
#define IN3 4
#define IN4 5
#define ENB 6
int tocdoA = 0;
int tocdoB = 0;
const unsigned long interval = 100;
unsigned long lastupdate = 0;
void setup(){
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENA, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENB, OUTPUT); 
}
void loop(){
  if( millis()- lastupdate>=interval){
    lastupdate=millis();
    if(tocdoA < 150) tocdoA +=5;
    if(tocdoB < 150) tocdoB +=5;
    tocdoA = constrain(tocdoA, 0, 150);
    tocdoB = constrain(tocdoB, 0, 150); 
    
  }
}
